{
  "schema": "taifoon.commerce.machine.v1",
  "id": "COMMERCE_MACHINE_v1",
  "rule": "one agentic commerce state machine: a listing walks read and list, a sale walks take, hire, settle and payout; every stage is one hop of the lineage or one stage of the listing lifecycle, in one of the six steps; every word of the old vocabularies points at one LED and, where it is a position, at one stage; a dead read prints —",
  "leds": {
    "green": {
      "id": "green",
      "shape": "dot",
      "glyph": "●",
      "label": "done",
      "means": "OK: the stage is reached and holds",
      "motion": "none"
    },
    "amber": {
      "id": "amber",
      "shape": "half",
      "glyph": "◐",
      "label": "in progress",
      "means": "in progress, or HELD: the reason and the next step are said",
      "motion": "pulse"
    },
    "red": {
      "id": "red",
      "shape": "cross",
      "glyph": "✕",
      "label": "broken",
      "means": "BROKEN: the read says the stage failed",
      "motion": "none"
    },
    "off": {
      "id": "off",
      "shape": "ring",
      "glyph": "○",
      "label": "not reached",
      "means": "MISSING or not reached yet",
      "motion": "none"
    },
    "dead": {
      "id": "dead",
      "shape": "dash",
      "glyph": "—",
      "label": "no read",
      "means": "the source of the state did not answer: nothing is guessed",
      "motion": "none"
    }
  },
  "steps": [
    {
      "id": "read",
      "side": "sell",
      "transform": "offer.in",
      "demand": [
        "classify"
      ]
    },
    {
      "id": "list",
      "side": "buy",
      "transform": "offer.out",
      "demand": [
        "list",
        "publish"
      ]
    },
    {
      "id": "take",
      "side": "buy",
      "transform": "job.in",
      "demand": [
        "demand",
        "match"
      ]
    },
    {
      "id": "hire",
      "side": "sell",
      "transform": "job.out",
      "demand": [
        "serve"
      ]
    },
    {
      "id": "settle",
      "side": "buy",
      "transform": "settle",
      "demand": [
        "assure",
        "settle_assured",
        "settle_uncovered"
      ]
    },
    {
      "id": "payout",
      "side": "sell",
      "transform": "payout",
      "demand": [
        "record"
      ]
    }
  ],
  "derive": {
    "before": "green",
    "at": "the position's led; amber while a later stage of the step is to come",
    "next": "amber when the place ends its step and the next step walks the same subject, else off",
    "after": "off",
    "dead": "dead",
    "hops": "green when every hop is green · red when one is red · dead when one is dead · off when none is reached · else amber; route_step none is left out",
    "one_line": "<step> · <place label>: <its say, or the side place's reason> — next: <its next>"
  },
  "stages": [
    {
      "id": "offer_in",
      "kind": "stage",
      "step": "read",
      "subject": "listing",
      "hop": "offer_in",
      "listing": "offer_in",
      "label": "offer in",
      "say": "the offer was read on its origin venue",
      "next": "classify it: one class of the catalogue",
      "moves": {
        "op": "POST /v1/agent-listings",
        "by": "the harvester (the venue adapter's offerIn) or the agent's owner"
      },
      "reads": {
        "op": "GET /v1/harvest"
      },
      "flow": {
        "node": "offer-in",
        "op": "POST /v1/onboard/spec/check",
        "dry": "POST /v1/onboard/spec/check"
      },
      "holds": "the harvester read the offer on its origin venue"
    },
    {
      "id": "classify",
      "kind": "stage",
      "step": "read",
      "subject": "listing",
      "hop": "classify",
      "listing": "classify",
      "label": "classify",
      "say": "the offer is one class of the catalogue, with a deterministic check",
      "next": "find the buyers of its class (the demand harvest)",
      "moves": {
        "op": "POST /v1/onboard/spec/check",
        "by": "the layer (the class language, harvest.cue classification)"
      },
      "reads": {
        "op": "GET /v1/classes"
      },
      "flow": {
        "node": "classify",
        "op": "GET /v1/classes",
        "dry": "GET /v1/classes"
      },
      "holds": "one class of the catalogue; an inference model is a name of models.cue"
    },
    {
      "id": "edge",
      "kind": "stage",
      "step": "list",
      "subject": "listing",
      "listing": "edge",
      "label": "edge",
      "say": "buyers paid for its class; our price, 20 % over the seller, is under what they pay",
      "next": "set its terms: one agreement, its pool and its meter",
      "moves": {
        "op": "POST /v1/exchanges/edge",
        "by": "the automatcher (open-market routes whose gates hold)"
      },
      "reads": {
        "op": "GET /v1/exchanges/auto"
      },
      "holds": "a route whose gates price, terms, pay_to and model all hold (demand usd_7d > 0)"
    },
    {
      "id": "exchange",
      "kind": "stage",
      "step": "list",
      "subject": "listing",
      "listing": "exchange",
      "label": "exchange",
      "say": "its terms are set: one agreement, its pool and its meter",
      "next": "open its cover pool, or list it without cover",
      "moves": {
        "op": "POST /v1/exchanges/auto",
        "by": "the automatcher (_AUTO_EXCHANGE_v1_)"
      },
      "reads": {
        "op": "GET /v1/exchanges"
      },
      "holds": "an exchange edge for the offer: lambda + pool + meter row + one agreement"
    },
    {
      "id": "covered",
      "kind": "stage",
      "step": "list",
      "subject": "listing",
      "listing": "covered",
      "label": "covered",
      "say": "its cover pool is open and priced",
      "next": "list it on each venue whose buyers ask for its class",
      "moves": {
        "op": "POST /v1/pools/open",
        "by": "an unsigned plan under the owner's economy bounds"
      },
      "reads": {
        "op": "GET /v1/assurance/markets"
      },
      "optional": true,
      "holds": "the edge's pool open on its line; jev-wilson quoteEconomy prices it; the bets round (AssuranceMarket) reads its record"
    },
    {
      "id": "listed",
      "kind": "stage",
      "step": "list",
      "subject": "listing",
      "hop": "listed",
      "listing": "listed",
      "label": "listed",
      "say": "it is listed on every venue whose buyers ask for its class",
      "next": "keep each listing equal to its edge, every pass",
      "moves": {
        "op": "POST /v1/listings/:id/venues",
        "by": "the buy venue's adapter offerOut"
      },
      "reads": {
        "op": "GET /v1/listings/:id/venues"
      },
      "flow": {
        "node": "listed",
        "op": "GET /v1/exchanges",
        "dry": "GET /v1/exchanges"
      },
      "holds": "every route of the offer reads list live on its buy venue"
    },
    {
      "id": "maintained",
      "kind": "stage",
      "step": "list",
      "subject": "listing",
      "listing": "maintained",
      "label": "kept",
      "say": "each pass its listing equals its edge: price, words and state",
      "next": "a buyer takes it on a venue",
      "moves": {
        "by": "the venue's listing pass (listing_lifecycle.maintain, every 15 min)"
      },
      "reads": {
        "op": "GET /v1/listings/:id"
      },
      "holds": "each pass the listing equals its edge (price, words, state)"
    },
    {
      "id": "hired",
      "kind": "stage",
      "step": "take",
      "subject": "sale",
      "hop": "hired",
      "label": "hired",
      "say": "a buyer hired it and paid in on its venue",
      "next": "the seller delivers in its own protocol",
      "moves": {
        "op": "POST /v1/exchanges/:edge_id/call",
        "by": "the buyer, through a door of the layer"
      },
      "reads": {
        "op": "GET /v1/exchanges/:edge_id/meter"
      },
      "flow": {
        "node": "hired",
        "op": "POST /v1/exchanges/:edge_id/call",
        "dry": "GET /v1/exchanges/:edge_id/meter"
      }
    },
    {
      "id": "delivered",
      "kind": "stage",
      "step": "hire",
      "subject": "sale",
      "hop": "delivered",
      "label": "delivered",
      "say": "the seller's answer passed its class's shape check",
      "next": "settle (a grade is optional)",
      "moves": {
        "op": "POST /v1/handshake",
        "by": "the seller (job.out)"
      },
      "reads": {
        "op": "GET /v1/exchanges/:edge_id/meter"
      },
      "flow": {
        "node": "delivered",
        "op": "GET /v1/exchanges/:edge_id/meter",
        "dry": "GET /v1/exchanges/:edge_id/meter"
      }
    },
    {
      "id": "graded",
      "kind": "stage",
      "step": "hire",
      "subject": "sale",
      "hop": "graded",
      "label": "graded",
      "say": "Jev graded the delivery; the verdict is recorded",
      "next": "settle",
      "moves": {
        "op": "POST /v1/demands/:id/grade",
        "by": "the evaluator (Jev)"
      },
      "reads": {
        "op": "GET /v1/judge/decisions/:id"
      },
      "optional": true,
      "flow": {
        "node": "graded",
        "op": "GET /v1/judge/decisions",
        "dry": "GET /v1/judge/decisions"
      }
    },
    {
      "id": "settled",
      "kind": "stage",
      "step": "settle",
      "subject": "sale",
      "hop": "settled",
      "label": "settled",
      "say": "the buyer's payment is verified and the delivery stands",
      "next": "write the legs of the payment",
      "moves": {
        "op": "POST /v1/settle",
        "by": "the settler"
      },
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      },
      "flow": {
        "node": "settled",
        "op": "GET /v1/resale/sales/:id",
        "dry": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "legs",
      "kind": "stage",
      "step": "settle",
      "subject": "sale",
      "hop": "legs",
      "label": "legs written",
      "say": "what the buyer paid is written as shares that add up to the payment",
      "next": "credit each share to its owner",
      "moves": {
        "by": "the one writer (packages/resale/core/sale-run.mjs, the ledger)"
      },
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      },
      "flow": {
        "node": "legs",
        "op": "GET /v1/exchanges/:edge_id/meter",
        "dry": "GET /v1/exchanges/:edge_id/meter"
      }
    },
    {
      "id": "accrued",
      "kind": "stage",
      "step": "settle",
      "subject": "sale",
      "hop": "accrued",
      "label": "accrued",
      "say": "each share is credited to its owner",
      "next": "put the share in the next payout",
      "moves": {
        "by": "the one writer (the ledger)"
      },
      "reads": {
        "op": "GET /v1/resale/sales"
      },
      "flow": {
        "node": "accrued",
        "op": "GET /v1/resale/sales",
        "dry": "GET /v1/resale/sales"
      }
    },
    {
      "id": "split",
      "kind": "stage",
      "step": "payout",
      "subject": "sale",
      "hop": "split",
      "label": "split",
      "say": "the share is in the next payout batch",
      "next": "pay the seller on its own venue",
      "moves": {
        "by": "the payout planner (packages/resale/core/payout-batch.mjs)"
      },
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      },
      "flow": {
        "node": "split",
        "op": "GET /v1/resale/sales/:id",
        "dry": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "paid",
      "kind": "stage",
      "step": "payout",
      "subject": "sale",
      "hop": "paid",
      "label": "PAID",
      "say": "the seller was paid on its own venue",
      "next": "record the receipt",
      "moves": {
        "by": "the vault's releaser: an unsigned plan, signed only through coord-sign"
      },
      "reads": {
        "op": "GET /v1/agents/payments"
      },
      "flow": {
        "node": "paid",
        "op": "GET /v1/resale/sales/:id",
        "dry": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "recorded",
      "kind": "stage",
      "step": "payout",
      "subject": "sale",
      "hop": "recorded",
      "label": "recorded",
      "say": "the sale and its proof are recorded",
      "next": "nothing: the sale is done",
      "moves": {
        "op": "POST /v1/vault/receipt",
        "by": "the layer"
      },
      "reads": {
        "op": "GET /v1/vault/receipts"
      },
      "flow": {
        "node": "recorded",
        "op": "GET /v1/vault/receipts",
        "dry": "GET /v1/resale/sales/:id"
      }
    }
  ],
  "side": [
    {
      "id": "refused",
      "step": "read",
      "kind": "terminal",
      "led": "off",
      "label": "refused",
      "reason": "a rule refused the offer: a closed vendor model, no deterministic check, or terms that forbid resale",
      "reads": {
        "op": "GET /v1/harvest"
      }
    },
    {
      "id": "held_entry",
      "step": "list",
      "kind": "held",
      "led": "amber",
      "label": "held: paid entry",
      "reason": "the venue lists only for a stake or a paid entry (zero dollars before a buyer paid)",
      "next": "an outside buyer pays for the class on another venue first",
      "reads": {
        "op": "GET /v1/exchanges/auto"
      }
    },
    {
      "id": "held_owner",
      "step": "list",
      "kind": "held",
      "led": "amber",
      "label": "held: owner step",
      "reason": "this step waits on one act only the owner takes",
      "next": "the owner's one act",
      "reads": {
        "op": "GET /v1/exchanges/auto"
      }
    },
    {
      "id": "paused",
      "step": "list",
      "kind": "held",
      "led": "amber",
      "label": "paused",
      "reason": "the edge is gone for two passes: the listing is paused, never deleted",
      "next": "the edge comes back and the pass resumes it",
      "reads": {
        "op": "GET /v1/listings/:id"
      }
    },
    {
      "id": "archived",
      "step": "list",
      "kind": "terminal",
      "led": "off",
      "label": "archived",
      "reason": "archived on the venue; a new handle is the way back",
      "reads": {
        "op": "GET /v1/listings/:id"
      }
    },
    {
      "id": "unmatched",
      "step": "take",
      "kind": "held",
      "led": "amber",
      "label": "unmatched",
      "reason": "a buyer asked and no seller fits yet",
      "next": "the loop matches it on its next tick",
      "reads": {
        "op": "GET /v1/demands/:id"
      }
    },
    {
      "id": "ended",
      "step": "take",
      "kind": "terminal",
      "led": "off",
      "label": "ended unpaid",
      "reason": "the job lapsed, expired or was rejected before a payment: nothing to refund",
      "reads": {
        "op": "GET /v1/explorer/jobs/:id"
      }
    },
    {
      "id": "on_hold",
      "step": "hire",
      "kind": "held",
      "led": "amber",
      "label": "on hold",
      "reason": "on hold (state Funded): the buyer's payment waits in escrow for the delivery",
      "next": "the seller delivers",
      "reads": {
        "op": "GET /v1/explorer/jobs/:id"
      }
    },
    {
      "id": "held_review",
      "step": "hire",
      "kind": "held",
      "led": "amber",
      "label": "held: review",
      "reason": "the grade is held: needs review, a rejection pending, or a dispute open",
      "next": "the review ends: the sale settles, or the buyer is refunded",
      "reads": {
        "op": "GET /v1/judge/decisions/:id"
      }
    },
    {
      "id": "failed_before_hire",
      "step": "take",
      "kind": "terminal",
      "led": "red",
      "label": "failed: not delivered",
      "reason": "no seller it was offered to delivered: each failed over and none was left; a paid demand is refunded in full",
      "reads": {
        "op": "GET /v1/demands/:id"
      }
    },
    {
      "id": "failed_hire",
      "step": "hire",
      "kind": "terminal",
      "led": "red",
      "label": "broken",
      "reason": "the delivery failed, or was proven false (cheat)",
      "reads": {
        "op": "GET /v1/explorer/jobs/:id"
      }
    },
    {
      "id": "refunded_on_reject",
      "step": "settle",
      "kind": "terminal",
      "led": "red",
      "label": "refunded: rejected",
      "reason": "a rejecting grade or ruling stood: the buyer is paid back on its own rail and the seller is not paid",
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "refunded",
      "step": "settle",
      "kind": "held",
      "led": "green",
      "label": "refunded",
      "reason": "a rejection that stands, an expiry or a no-show: the buyer is paid back on its own rail",
      "next": "record the refund",
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "failed_settle",
      "step": "settle",
      "kind": "terminal",
      "led": "red",
      "label": "broken",
      "reason": "the settlement reverted, or its proof does not hold",
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "held_leg",
      "step": "payout",
      "kind": "held",
      "led": "amber",
      "label": "Held",
      "reason": "the share is held until its check clears: its proof, the payout network's balance or a spending limit",
      "next": "the check clears and the share is released",
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      }
    },
    {
      "id": "forfeited",
      "step": "payout",
      "kind": "terminal",
      "led": "red",
      "label": "forfeited",
      "reason": "a held share was forfeited: a slash or a false delivery that stands",
      "reads": {
        "op": "GET /v1/resale/sales/:id"
      }
    }
  ],
  "moves": [
    {
      "from": "offer_in",
      "to": "classify",
      "via": [
        "coordination.demand.v1/classify",
        "coordination.seller-coord-buyer.v1/offer.in",
        "genie:listing_lifecycle offer_in->classify"
      ]
    },
    {
      "from": "offer_in",
      "to": "refused",
      "via": [
        "genie:listing_lifecycle offer_in->refused"
      ]
    },
    {
      "from": "classify",
      "to": "refused",
      "via": [
        "coordination.compute.v1/reject_attestation"
      ]
    },
    {
      "from": "classify",
      "to": "edge",
      "via": [
        "genie:listing_lifecycle classify->edge"
      ]
    },
    {
      "from": "edge",
      "to": "held_entry",
      "via": [
        "genie:listing_lifecycle edge->held_entry"
      ]
    },
    {
      "from": "held_entry",
      "to": "exchange",
      "via": [
        "genie:listing_lifecycle held_entry->exchange"
      ]
    },
    {
      "from": "edge",
      "to": "held_owner",
      "via": [
        "coordination.demand.v1/list"
      ]
    },
    {
      "from": "held_owner",
      "to": "exchange",
      "via": [
        "coordination.demand.v1/list"
      ]
    },
    {
      "from": "edge",
      "to": "exchange",
      "via": [
        "genie:listing_lifecycle edge->exchange"
      ]
    },
    {
      "from": "exchange",
      "to": "covered",
      "via": [
        "genie:listing_lifecycle exchange->covered"
      ]
    },
    {
      "from": "exchange",
      "to": "listed",
      "via": [
        "coordination.demand.v1/list",
        "coordination.seller-coord-buyer.v1/offer.out"
      ]
    },
    {
      "from": "covered",
      "to": "listed",
      "via": [
        "genie:listing_lifecycle covered->listed",
        "coordination.seller-coord-buyer.v1/offer.out"
      ]
    },
    {
      "from": "listed",
      "to": "maintained",
      "via": [
        "genie:listing_lifecycle listed->maintained",
        "coordination.demand.v1/publish",
        "coordination.publish.v1/verify"
      ],
      "op": "POST /v1/listings/:id/verify"
    },
    {
      "from": "maintained",
      "to": "paused",
      "via": [
        "genie:listing_lifecycle maintained->paused",
        "coordination.publish.v1/go_stale"
      ],
      "op": "POST /v1/agent-listings/:id"
    },
    {
      "from": "paused",
      "to": "maintained",
      "via": [
        "genie:listing_lifecycle paused->maintained",
        "coordination.publish.v1/reverify"
      ],
      "op": "POST /v1/agent-listings/:id/resume"
    },
    {
      "from": "maintained",
      "to": "archived",
      "via": [
        "coordination.publish.v1/withdraw_verified"
      ],
      "op": "POST /v1/agent-listings/:id"
    },
    {
      "from": "paused",
      "to": "archived",
      "via": [
        "coordination.publish.v1/withdraw_stale"
      ],
      "op": "POST /v1/agent-listings/:id"
    },
    {
      "from": "listed",
      "to": "hired",
      "via": [
        "coordination.demand.v1/match",
        "coordination.seller-coord-buyer.v1/buy",
        "coordination.seller-coord-buyer.v1/job.in"
      ]
    },
    {
      "from": "maintained",
      "to": "hired",
      "via": [
        "coordination.demand.v1/match",
        "coordination.seller-coord-buyer.v1/job.in"
      ]
    },
    {
      "from": "listed",
      "to": "unmatched",
      "via": [
        "coordination.demand.v1/unmatched"
      ]
    },
    {
      "from": "maintained",
      "to": "unmatched",
      "via": [
        "coordination.demand.v1/unmatched"
      ]
    },
    {
      "from": "unmatched",
      "to": "hired",
      "via": [
        "coordination.demand.v1/match"
      ]
    },
    {
      "from": "hired",
      "to": "ended",
