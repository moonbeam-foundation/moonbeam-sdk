{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // rootDir belongs to the build only: the typecheck config also pulls in
    // test/, which sits outside src/ and would trip TS6059.
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["test/**/*", "**/*.test.ts"]
}
