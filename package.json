{
  "name": "@moonbeam-foundation/sdk",
  "version": "0.11.0",
  "description": "Agentic commerce SDK for AI agents: buy and sell agent work on every market (x402, MCP, A2A, Virtuals ACP / ERC-8183, Olas, BitAgent, ERC-8004, NEAR), with graded jobs and assurance on Base. The Moonbeam Studio's workflows as code.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp/events.d.ts",
      "import": "./dist/acp/events.js"
    },
    "./actors": {
      "types": "./dist/actors/index.d.ts",
      "import": "./dist/actors/index.js"
    },
    "./adapters/acp": {
      "types": "./dist/adapters/acp.d.ts",
      "import": "./dist/adapters/acp.js"
    },
    "./connect": {
      "types": "./dist/connect/http.d.ts",
      "import": "./dist/connect/http.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher/index.d.ts",
      "import": "./dist/launcher/index.js"
    },
    "./adapters/stamp": {
      "types": "./dist/adapters/stamp.d.ts",
      "import": "./dist/adapters/stamp.js"
    },
    "./onboard": {
      "types": "./dist/onboard/index.d.ts",
      "import": "./dist/onboard/index.js"
    },
    "./pools": {
      "types": "./dist/pools/index.d.ts",
      "import": "./dist/pools/index.js"
    },
    "./judge": {
      "types": "./dist/judge/index.d.ts",
      "import": "./dist/judge/index.js"
    },
    "./assurance": {
      "types": "./dist/assurance/index.d.ts",
      "import": "./dist/assurance/index.js"
    },
    "./resale": {
      "types": "./dist/resale/index.d.ts",
      "import": "./dist/resale/index.js"
    },
    "./x402": {
      "types": "./dist/x402/index.d.ts",
      "import": "./dist/x402/index.js"
    },
    "./proof": {
      "types": "./dist/proof/index.d.ts",
      "import": "./dist/proof/index.js"
    },
    "./arbitration": {
      "types": "./dist/arbitration/index.d.ts",
      "import": "./dist/arbitration/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    },
    "./attest": {
      "types": "./dist/attest/index.d.ts",
      "import": "./dist/attest/index.js"
    },
    "./abi": {
      "types": "./dist/abi/index.d.ts",
      "import": "./dist/abi/index.js"
    },
    "./cover": {
      "types": "./dist/cover/index.d.ts",
      "import": "./dist/cover/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "import": "./dist/jobs/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./devnet": {
      "types": "./dist/devnet/index.d.ts",
      "import": "./dist/devnet/index.js"
    },
    "./market": {
      "types": "./dist/market/index.d.ts",
      "import": "./dist/market/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "bin",
    "examples",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && vitest run --reporter=dot",
    "prepublishOnly": "npm run check",
    "postbuild": "node scripts/postbuild.mjs",
    "gen:registry": "node scripts/gen-moonbeam-acp.mjs",
    "check:registry": "node scripts/gen-moonbeam-acp.mjs --check",
    "check:pins": "node scripts/check-pins.mjs",
    "check:diagrams": "node scripts/gen-diagrams.mjs >/dev/null && git diff --exit-code -- 'docs/workflows/*.svg' docs/WORKFLOWS.md",
    "check": "npm run typecheck && npm run build && npm test && npm run check:pins && npm run check:workflows && npm run check:diagrams",
    "sync": "node scripts/sync.mjs",
    "check:sync": "node scripts/sync.mjs --check",
    "test:fork": "node test/fork/run-fork.mjs",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "e2e:devnet": "npm run build && node scripts/devnet-onboard.mjs",
    "gen:workflows": "node scripts/gen-workflows.mjs",
    "check:workflows": "node scripts/gen-workflows.mjs --check"
  },
  "keywords": [
    "moonbeam",
    "agentic-commerce",
    "ai-agents",
    "agent-marketplace",
    "agent-payments",
    "x402",
    "mcp",
    "a2a",
    "erc-8183",
    "erc-8004",
    "virtuals",
    "virtuals-acp",
    "agent-commerce-protocol",
    "olas",
    "bitagent",
    "near-ai",
    "base",
    "usdc",
    "glmr",
    "ai-agent-sdk",
    "autonomous-agents",
    "agent-to-agent",
    "agent-workflows",
    "escrow",
    "assurance",
    "settlement",
    "judge",
    "jev"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "viem": "^2.57.6",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@taifoon/jev": "^0.3.0",
    "@taifoon/jev-wilson": "^0.3.1"
  },
  "bin": {
    "moonbeam": "bin/moonbeam.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonbeam-foundation/moonbeam-sdk.git"
  },
  "homepage": "https://github.com/moonbeam-foundation/moonbeam-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bugs": {
    "url": "https://github.com/moonbeam-foundation/moonbeam-sdk/issues",
    "email": "builders@moonbeam.foundation"
  },
  "author": "Moonbeam Foundation <builders@moonbeam.foundation>"
}
